NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://whatsapp:PAROLA@localhost:5432/whatsapp_ai

# OpenRouter (https://openrouter.ai/keys) — orice model din https://openrouter.ai/models
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=google/gemini-2.5-flash
# Opțional: model de rezervă dacă primul pică
# LLM_FALLBACK_MODEL=anthropic/claude-sonnet-4.5

# Opțional: transcriere mesaje vocale (Groq Whisper). Fără cheie → vocalele sunt ignorate.
# GROQ_API_KEY=gsk_...

# Criptare credențiale WhatsApp în DB — generează cu: openssl rand -hex 32
# NU o pierde: fără ea, sesiunea salvată nu mai poate fi decriptată (trebuie scanat QR din nou).
WHATSAPP_ENC_KEY=
