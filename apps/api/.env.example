NODE_ENV=development
PORT=3001

# PostgreSQL (local: docker run -d --name wa-pg -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=whatsapp_ai -p 5432:5432 postgres:16-alpine)
DATABASE_URL=postgresql://postgres:dev@localhost:5432/whatsapp_ai

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...
# Orice model din https://openrouter.ai/models
LLM_MODEL=google/gemini-2.5-flash
# Opțional: model de rezervă dacă primul pică
# LLM_FALLBACK_MODEL=anthropic/claude-sonnet-4.5

# Opțional: transcriere mesaje vocale (Groq Whisper). Fără cheie → vocalele sunt ignorate.
# GROQ_API_KEY=gsk_...

# Criptare credențiale WhatsApp în DB — generează cu: openssl rand -hex 32
WHATSAPP_ENC_KEY=change_me_openssl_rand_hex_32_xxxxxxxxxxxxxxxx

# Dashboard web minimal (HTTP Basic, user oricare). Lipsă → doar QR în loguri.
DASHBOARD_PASSWORD=change_me_min_12_chars

# Nr. proxy-uri de încredere (Caddy / cloudflared în față = 1).
TRUST_PROXY_HOPS=1
