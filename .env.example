# .env pentru docker compose (copiază în .env pe VPS: cp .env.example .env && nano .env)

# Postgres (folosește hex — fără caractere speciale, intră în DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-2.5-flash
# LLM_FALLBACK_MODEL=anthropic/claude-sonnet-4.5

# Opțional: transcriere vocale (Groq Whisper)
# GROQ_API_KEY=

# openssl rand -hex 32  — NU o pierde: fără ea, sesiunea WhatsApp salvată nu mai poate fi decriptată
WHATSAPP_ENC_KEY=

# Parola dashboard-ului (min 12 caractere). Lasă gol ca să dezactivezi dashboard-ul.
DASHBOARD_PASSWORD=

# Proxy în fața API-ului (Caddy / cloudflared) = 1
TRUST_PROXY_HOPS=1

# Profil "caddy": domeniul public al dashboard-ului
# DOMAIN=wa.domeniultau.ro

# Profil "tunnel": token din Cloudflare Zero Trust → Networks → Tunnels
# CLOUDFLARE_TUNNEL_TOKEN=
